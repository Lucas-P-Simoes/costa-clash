{
  "name": "costa-clash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "worker:dev": "wrangler dev --local --config worker/wrangler.toml",
    "worker:migrar:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.toml",
    "worker:migrar:remoto": "wrangler d1 migrations apply DB --remote --config worker/wrangler.toml",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "arte:manifesto": "node scripts/arte-manifesto.mjs",
    "arte:verificar": "node scripts/arte-verificar.mjs",
    "arte:prompts": "node scripts/arte-prompts.mjs",
    "arte:gerar": "node scripts/gerar-arte.mjs",
    "test:e2e": "playwright test",
    "e2e:matriz": "node e2e/scripts/matriz.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
